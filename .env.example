# Container deployment template. Copy to .env and fill credentials and resource paths.
# Assign each source version a new RELEASE_TAG and deploy its images together.
RELEASE_TAG=0.2.0
POSTGRES_USER=ira
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=ira
CLAMD_CONFIG_FILE=./config/scanner/clamd.conf

# Optional: stack.sh defaults to 127.0.0.1:8080.
# WEB_BIND_HOST=127.0.0.1
# WEB_PORT=8080

# HOST paths: pre-existing, readable/traversable by container UID 10001; mounted read-only.
DOCLING_MODELS_DIR=/absolute/path/to/docling-models
BGE_M3_TOKENIZER_DIR=/absolute/path/to/bge-m3
QA_TOKENIZER_DIR=/absolute/path/to/deepseek-flash
CHUNKING_MODEL_TOKENIZER_DIR=/absolute/path/to/deepseek-v4-pro
RERANKER_TOKENIZER_DIR=/absolute/path/to/bge-reranker-v2-m3

# CONTAINER paths below. APP_SETTINGS remains the only application environment input.
# Single-quoted multiline JSON is literal: no ${POSTGRES_PASSWORD} substitution inside it.
# Fill the full database URL with URL-encoded credentials matching POSTGRES_* above.
# Preserve each environment's index/profile identities, model credentials, budgets and groups.
# New-task budgets use input tokens. Keep real secrets in ignored env files only.
APP_SETTINGS='{
  "database_url": "postgresql+psycopg://ira:replace-with-db-password@postgres:5432/ira",
  "redis_url": "redis://redis:6379/0",
  "managed_directory": "/data/managed",
  "queue_groups": {
    "document_group": "document_workers",
    "agent_group": "agent_workers",
    "wiki_group": "wiki_workers"
  },
  "maintenance": {
    "publisher": {
      "attempts_per_second": 1
    }
  },
  "ingestion": {
    "parser": {
      "threads": 2,
      "artifacts_path": "/models/docling",
      "temporary_directory": "/work/parser",
      "libreoffice_path": "/usr/bin/libreoffice",
      "pdf_backend": "mineru",
      "timeout_seconds": 1800,
      "mineru": {
        "api_base_url": "https://mineru.net",
        "api_key": "replace-with-mineru-key",
        "request_timeout_seconds": 60,
        "poll_interval_seconds": 2,
        "max_result_bytes": 104857600,
        "max_uncompressed_bytes": 524288000
      }
    },
    "chunking": {
      "tokenizer_dir": "/models/bge-m3",
      "target_tokens": 512,
      "max_tokens": 1024,
      "strategy": "model",
      "model": {
        "endpoint": "https://api.deepseek.com/chat/completions",
        "api_key": "replace-with-deepseek-key",
        "model_id": "deepseek-v4-pro",
        "context_window_tokens": 1048576,
        "max_output_tokens": 65536,
        "request_timeout_seconds": 180
      },
      "model_tokenizer_dir": "/models/deepseek-v4-pro",
      "model_input_token_limit": 262144
    }
  },
  "wiki": {
    "model": {
      "endpoint": "https://api.deepseek.com/chat/completions",
      "api_key": "replace-with-deepseek-key",
      "model_id": "deepseek-flash",
      "context_window_tokens": 1048576,
      "max_output_tokens": 32768,
      "request_timeout_seconds": 180
    },
    "execution": {"budget_limit": "2000000", "max_retries": 3},
    "worker": {"concurrency": 1},
    "discovery_interval_seconds": 259200,
    "model_concurrency": 4,
    "tool_concurrency": 4,
    "structure_repair_limit": 3
  },
  "qa": {
    "finalization_reserve_input_tokens": 100000,
    "worker": {
      "concurrency": 1,
      "lease_seconds": 60,
      "renew_seconds": 15
    },
    "history_max_turns": 4,
    "tokenizer_dir": "/models/qa-tokenizer",
    "execution": {
      "budget_limit": "300000",
      "max_retries": 3
    },
    "business_timezone": "Asia/Shanghai",
    "clarification_limit": 2,
    "structure_repair_limit": 1,
    "retrieval_round_limit": 3,
    "tool_step_limit": 12,
    "tool_concurrency": 4,
    "candidate_preview_limit": 10,
    "model": {
      "endpoint": "https://api.deepseek.com/chat/completions",
      "api_key": "replace-with-deepseek-key",
      "model_id": "deepseek-flash",
      "context_window_tokens": 1048576,
      "max_output_tokens": 100000,
      "request_timeout_seconds": 90
    },
    "search_limit_per_profile": 10,
    "rerank_candidate_limit": 15,
    "neighbor_radius": 1,
    "read_chunk_limit": 24,
    "reranker": {
      "endpoint": "https://api.ppio.com/openai/v1/rerank",
      "model_id": "baai/bge-reranker-v2-m3",
      "api_key_profile_id": "bge-m3-zh-v1",
      "tokenizer_dir": "/models/bge-reranker-v2-m3",
      "max_pair_tokens": 8192,
      "request_timeout_seconds": 60,
      "requests_per_minute": 30
    }
  },
  "api": {
    "default_index_profile_id": "bge-m3-zh-v1",
    "policy": {"scan_timeout_seconds": 120},
    "execution": {
      "budget_limit": "300000",
      "max_retries": 3
    },
    "scanner": {
      "config_file": "/etc/ira/clamd.conf",
      "unix_socket": "/run/clamav/clamd.sock",
      "tcp_host": "127.0.0.1",
      "tcp_port": 3310
    },
    "max_concurrent_uploads": 2,
    "slot_wait_seconds": 2,
    "reception_timeout_seconds": 120
  },
  "index_profiles": {
    "bge-m3-zh-v1": {
      "elasticsearch": {
        "url": "http://elasticsearch:9200",
        "index_name": "reimbursement-bge-m3",
        "api_key": null,
        "ca_certs": null,
        "request_timeout_seconds": 30
      },
      "embedding": {
        "endpoint": "https://api.ppio.com/openai/v1/embeddings",
        "api_key": "replace-with-ppio-key",
        "model_id": "baai/bge-m3",
        "batch_size": 16,
        "request_timeout_seconds": 60,
        "requests_per_minute": 1000
      }
    }
  }
}'
